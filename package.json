{
    "name": "cranetype",
    "description": "鹤键 CraneType —— 中文全拼 / 小鹤双拼打字练习，含英文、代码与自定义文本四种模式，40 套主题",
    "version": "20231127a",
    "packageManager": "npm@10.9.7",
    "homepage": "https://baoru0908.github.io/typing-cn-flypy/",
    "repository": {
        "type": "git",
        "url": "https://github.com/baoru0908/typing-cn-flypy.git"
    },
    "scripts": {
        "dev": "vite",
        "build": "tsc && vite build",
        "build-nobase": "tsc && vite build --mode nobase",
        "build-single": "tsc && vite build --config vite.config.single.ts && node scripts/pack-single.js",
        "preview": "vite preview",
        "deploy": "npm run build && node scripts/deploy.js",
        "test": "node --experimental-strip-types scripts/test-flypy.mjs",
        "lint": "eslint --ext .jsx,.js,.tsx,.ts src",
        "prettier": "prettier --write 'src/**/*.{js,jsx,ts,tsx,less}'",
        "word": "node scripts/generateWords.js",
        "update-version": "node scripts/updateVersion.js"
    },
    "dependencies": {
        "@ant-design/icons": "^4.7.0",
        "antd": "^4.19.1",
        "dayjs": "^1.10.8",
        "pinyin-pro": "^3.15.2",
        "react": "^17.0.2",
        "react-dom": "^17.0.2",
        "react-redux": "^7.2.6",
        "react-router-dom": "^6.2.2",
        "redux": "^4.1.2"
    },
    "devDependencies": {
        "@babel/core": "^7.17.5",
        "@babel/plugin-syntax-flow": "^7.16.7",
        "@babel/plugin-transform-react-jsx": "^7.17.3",
        "@npmcli/package-json": "^1.0.1",
        "@types/less": "^3.0.3",
        "@types/node": "^17.0.21",
        "@types/react": "^17.0.39",
        "@types/react-dom": "^17.0.13",
        "@types/react-redux": "^7.1.23",
        "@vitejs/plugin-legacy": "^1.7.1",
        "@vitejs/plugin-react": "^1.0.7",
        "chalk": "^4.1.2",
        "eslint": "^8.10.0",
        "eslint-config-react-app": "^7.0.0",
        "eslint-plugin-prettier": "^4.0.0",
        "gh-pages": "^3.2.3",
        "less": "^4.1.2",
        "mustache": "^4.2.0",
        "open": "^8.4.0",
        "postcss": "^8.4.8",
        "postcss-less": "^6.0.0",
        "prettier": "^2.5.1",
        "rollup": "^2.0.0",
        "rollup-plugin-visualizer": "^5.6.0",
        "stylelint": "^14.5.3",
        "stylelint-config-prettier": "^9.0.3",
        "stylelint-config-standard": "^25.0.0",
        "typescript": "^4.5.4",
        "vite": "^2.8.0"
    }
}
